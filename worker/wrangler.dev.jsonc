{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-o-matic-pageviews-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "vars": {
    "DEPLOYMENT_ENV": "development",
    "ALLOWED_ORIGIN": "https://text-o-matic-dev.nickspeelman.com",
    "SOURCE_URL": "https://github.com/nickspeelman/text-o-matic-dev/blob/Main/worker/src/index.js",
    "SCHEMA_URL": "https://github.com/nickspeelman/text-o-matic-dev/blob/Main/worker/schema.sql"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
